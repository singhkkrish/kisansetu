# Supabase project (Settings -> API). Copy this file to .env.local and fill in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app, used for absolute links in SMS slips.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# How many minutes a phone clock may run ahead of the server before an entry
# is held for manager review. Old timestamps are fine (centres work offline).
SYNC_MAX_FUTURE_SKEW_MINUTES=10

# Mock bank payment file (all optional). See docs/mock-bank-format.md.
# BANK_FILE_COLUMNS=beneficiary_name,account_number,ifsc,amount,payment_ref,payment_run_id
# BANK_FILE_DELIMITER=comma
# BANK_FILE_HEADER=true
