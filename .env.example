# Supabase project (Settings -> API). Copy this file to .env.local and fill in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app, used for absolute links in SMS slips.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Maximum allowed difference (in minutes) between device time and server time
# before a synced entry is flagged for review.
SYNC_MAX_CLOCK_SKEW_MINUTES=720
